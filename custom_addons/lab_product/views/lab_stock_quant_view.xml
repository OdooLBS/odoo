<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lab_view_stock_quant_tree_editable" model="ir.ui.view">
        <field name="name">stock.quant.list.editable.lab</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
             <xpath expr="//list/field[@name='inventory_quantity_auto_apply']" position="before">
                <field name="qty_used" string="Quantity Used" groups="stock.group_stock_manager"/>
            </xpath>
        </field>
    </record>
</odoo>

